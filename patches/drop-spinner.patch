-  private fun IHTTPSession.queryParam(name: String): String? {
-    if (queryParameterString == null) {
-      return null
-    }
-
-    val params: Map<String, String> = queryParameterString
-      .split("&")
-      .mapNotNull { part ->
-        val parts = part.split("=")
-        if (parts.size == 2) {
-          parts[0] to parts[1]
-        } else {
-          null
-        }
-      }
-      .toMap()
-
-    return params[name]
-  }
