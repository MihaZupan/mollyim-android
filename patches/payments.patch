-  fun createReportVerifier(): Verifier {
-    return createVerifier(ServiceConfig::report)
-  }
-
-  @Throws(AttestationException::class)
-  private fun createVerifier(getConfigValue: (ServiceConfig) -> ByteArray): Verifier {
