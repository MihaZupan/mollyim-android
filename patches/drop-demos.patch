From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MihaZupan <miha@mihubot.xyz>
Date: Wed, 4 Nov 2026 08:10:27 +0100
Subject: [PATCH] tooling: preserve reference exclusion of upstream
 demonstration apps

Keep SOURCE-classified nonshipping demo exclusions. This preserves current tooling support choices; it is not new removal permission.

Extract final intent, not historical commit replay. All blobs/modes in this
boundary come from untouched Molly 892d6264ba007b5458a8b74cf9183c665f1f17a1.
SOURCE ledger: e8f627b41b4358bfc78d7c410d2e5c8f12e934481682c0389750efb2bbcac00f
Feature families: DROP-DEMO-001
Dependencies: preceding cumulative extraction boundaries; validate the completed stack.
Validation: final GNU app JVM/package/lint and exact reference tree/resource/API comparison;
runtime parity and independent review remain separate parent gates.

diff --git a/demo/apng/.gitignore b/demo/apng/.gitignore
deleted file mode 100644
index 42afabfd2abebf31384ca7797186a27a4b7dbee8..0000000000000000000000000000000000000000
--- a/demo/apng/.gitignore
+++ /dev/null
@@ -1 +0,0 @@
-/build
\ No newline at end of file
diff --git a/demo/apng/build.gradle.kts b/demo/apng/build.gradle.kts
deleted file mode 100644
index 0f260d23211848ef405117424f29761d445f9e4d..0000000000000000000000000000000000000000
--- a/demo/apng/build.gradle.kts
+++ /dev/null
@@ -1,16 +0,0 @@
-plugins {
-  id("signal-sample-app")
-  alias(libs.plugins.compose.compiler)
-}
-
-android {
-  namespace = "org.signal.apng.demo"
-
-  defaultConfig {
-    applicationId = "org.signal.apng"
-  }
-}
-
-dependencies {
-  implementation(project(":lib:apng"))
-}
diff --git a/demo/apng/proguard-rules.pro b/demo/apng/proguard-rules.pro
deleted file mode 100644
index 481bb434814107eb79d7a30b676d344b0df2f8ce..0000000000000000000000000000000000000000
--- a/demo/apng/proguard-rules.pro
+++ /dev/null
@@ -1,21 +0,0 @@
-# Add project specific ProGuard rules here.
-# You can control the set of applied configuration files using the
-# proguardFiles setting in build.gradle.
-#
-# For more details, see
-#   http://developer.android.com/guide/developing/tools/proguard.html
-
-# If your project uses WebView with JS, uncomment the following
-# and specify the fully qualified class name to the JavaScript interface
-# class:
-#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
-#   public *;
-#}
-
-# Uncomment this to preserve the line number information for
-# debugging stack traces.
-#-keepattributes SourceFile,LineNumberTable
-
-# If you keep the line number information, uncomment this to
-# hide the original source file name.
-#-renamesourcefileattribute SourceFile
\ No newline at end of file
