-          }
-        }
-      )
-    }
-  ) { paddingValues ->
-    Column(
-      modifier = Modifier
-        .fillMaxSize()
-        .padding(paddingValues)
-    ) {
-      content()
-    }
-  }
-}
-
-@Composable
-private fun SettingsRow(title: String, onClick: () -> Unit) {
