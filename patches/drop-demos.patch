-    val theirMac = frame.copyOfRange(payloadLength, frameLength)
-    mac.update(frame, 0, payloadLength)
-    val ourMac = mac.doFinal().copyOf(10)
-    if (!MessageDigest.isEqual(ourMac, theirMac)) {
