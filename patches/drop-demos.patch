-  @RequiresApi(26)
-  private suspend fun doTranscode(
-    context: Context,
-    inputUri: Uri,
-    enableFastStart: Boolean,
-    outputTag: String,
-    onProgress: (Int) -> Unit,
-    createTranscoder: (File) -> StreamingTranscoder
