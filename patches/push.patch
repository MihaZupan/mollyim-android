diff --git a/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/data/DataAndStorageSettingsRepositoryTest.kt b/app/src/test/java/org/thoughtcrime/securesms/components/settings/app/data/DataAndStorageSettingsRepositoryTest.kt
