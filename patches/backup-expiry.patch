+  private fun prepareJob(scoped: Boolean): NotificationController {
+    mockkStatic(BackupUtil::class, BackupFileIOError::class, NotificationChannels::class, AttachmentSecretProvider::class, GenericForegroundService::class, SignalDatabase::class, SignalStore::class)
