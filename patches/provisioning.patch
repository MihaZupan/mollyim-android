+    byte[] ciphertext      = joined.substring(16 + 1, joined.size() - 32).toByteArray();
+    byte[] ivAndCiphertext = joined.substring(0, joined.size() - 32).toByteArray();
+    byte[] mac             = joined.substring(joined.size() - 32).toByteArray();
