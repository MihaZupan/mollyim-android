+      return staticUpdateDescriptionWithExpiration(context.getString(R.string.MessageRecord_call_message_with_date, context.getString(R.string.MessageRecord_missed_voice_call), getCallDateString(context)), Glyph.PHONE, ContextCompat.getColor(context, org.signal.core.ui.R.color.core_red_shade), ContextCompat.getColor(context, org.signal.core.ui.R.color.core_red));
