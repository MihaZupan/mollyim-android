+  @JvmStatic
+  fun trimEndPeriodInSingleSentence(text: CharSequence?): CharSequence? {
+    if (text == null || text.length < 2) {
+      return text
+    }
+    val len = text.length
+    for (i in 0..<len) {
+      if (text[i] == '.') {
+        if (i + 1 < len) {
+          // Multiple sentences
+          break
+        }
+        return text.subSequence(0, i)
+      }
+    }
+    return text
+  }
